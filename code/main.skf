// skyforge-pagination

функция рассчитать_пагинацию(всего, страница, на_странице) {
    если на_странице <= 0 { бросить "на_странице должно быть больше 0" }
    
    пусть всего_страниц = пол((всего + на_странице - 1) / на_странице)
    пусть текущая = страница
    если текущая < 1 { текущая = 1 }
    если текущая > всего_страниц { текущая = всего_страниц }
    
    вернуть {
        "всего": всего,
        "всего_страниц": всего_страниц,
        "текущая": текущая,
        "смещение": (текущая - 1) * на_странице,
        "есть_следующая": текущая < всего_страниц,
        "есть_предыдущая": текущая > 1
    }
}
